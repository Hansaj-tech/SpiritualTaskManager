rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isKshetraAdminOf(uid) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let target = get(/databases/$(database)/documents/users/$(uid)).data;
      return isSignedIn()
        && me.isKshetraAdmin == true
        && me.kshetra == target.kshetra;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isKshetraAdmin', 'updatedAt']));

      match /activityLogs/{dateKey} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin() || isKshetraAdminOf(uid);
      }

      match /reminders/{activityId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
